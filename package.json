{
  "name": "cube-crashers",
  "version": "0.2.0",
  "description": "Voxel lane/horde shooter with tower defense elements. Crash the retro cubes!",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "app:dev": "concurrently -k \"vite --port 5173 --strictPort\" \"wait-on tcp:5173 && cross-env-shell VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "app": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "three": "^0.160.1",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.160.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wait-on": "^9.5.1"
  },
  "main": "electron/main.cjs",
  "author": "Dominik Amann"
}
